# Copie este arquivo para ".env" (na raiz do projeto) e preencha.
# O .env NÃO vai para o repositório/entrega: contém a senha.
#
# DB_HOST: IP da VM (rede em modo Bridge) ou 127.0.0.1 (NAT com port forwarding)
DB_HOST=192.168.0.50
DB_PORT=3306
DB_USER=usuport_app
DB_PASSWORD=troque-esta-senha
DB_NAME=usuport

# Opcional: usuário com permissão de CREATE, usado só por scripts/carregar_staging.py
# DB_ADMIN_USER=usuport_admin
# DB_ADMIN_PASSWORD=troque-esta-senha
