/*
  UNIFACS — Projeto Integrador de Banco de Dados — A3
  Time Índice — Grupo 4 | Cenário: USUPORT
  DER conceitual em notação de Chen (Graphviz, motor neato, posições fixas).
  Renderizar:  neato -Tpng -Gdpi=200 der_conceitual.dot -o der_conceitual.png
  (ou: python scripts/gerar_diagramas.py)

  Convenções (estilo preto e branco):
    retângulo            = entidade
    losango              = relacionamento
    caixa arredondada    = atributo   (sublinhado = chave)
    borda dupla          = atributo multivalorado
    borda tracejada      = atributo derivado (não armazenado)
    caixa com sub-caixas = atributo composto
    linha dupla          = participação total
*/
graph DER_conceitual {
  graph [layout=neato, splines=line, overlap=true, outputorder=edgesfirst, pad=0.35,
         fontname="Arial", fontsize=20, labelloc=t,
         label=<<B>USUPORT — DER conceitual (notação de Chen)</B><BR/><FONT POINT-SIZE="12">Time Índice — Grupo 4 · sinistros em rodovias federais (PRF 2024)</FONT><BR/> >];
  node  [fontname="Arial", fontsize=11, color="black", penwidth=1.1, style=filled, fillcolor="white"];
  edge  [color="black", penwidth=1.0, fontname="Arial", fontsize=11];

  /* ===================== ENTIDADES ===================== */
  node [shape=box, fontsize=13, penwidth=1.6, width=1.6, height=0.55];
  ACIDENTE [label=<<B>ACIDENTE</B>>,          pos="0,0!"];
  VEICULO  [label=<<B>VEÍCULO</B>>,           pos="12,0!"];
  PESSOA   [label=<<B>PESSOA</B>>,            pos="12,-6!"];
  UOP      [label=<<B>UOP</B>>,               pos="2.6,-6.6!",  width=1.1];
  DELEG    [label=<<B>DELEGACIA</B>>,         pos="-1,-6.6!"];
  SUPER    [label=<<B>SUPERINTENDÊNCIA</B>>,  pos="-4.9,-6.6!", width=2.1];

  /* ===================== RELACIONAMENTOS ===================== */
  node [shape=diamond, fontsize=11, penwidth=1.2, width=1.35, height=0.75];
  r_env_v  [label="envolve",   pos="6,0!"];
  r_env_p  [label="envolve",   pos="6,-3!"];
  r_ocupa  [label="ocupa",     pos="12,-3!"];
  r_at_u   [label="atende",    pos="2.6,-3.3!"];
  r_at_d   [label="atende",    pos="-1,-3.3!"];
  r_at_s   [label="atende",    pos="-4.9,-3.3!"];
  r_sub_ud [label="subordina", pos="0.8,-6.6!", width=1.45];
  r_sub_ds [label="subordina", pos="-2.95,-6.6!", width=1.45];

  /* ===================== ATRIBUTOS ===================== */
  node [shape=box, style="rounded,filled", fontsize=10, penwidth=1.0, width=0, height=0.3, margin="0.10,0.03"];

  /* ACIDENTE — coluna da esquerda: simples e derivados */
  a_id    [label=<<U>id</U>>,              pos="-6.7,2.25!"];
  a_data  [label="data",                   pos="-6.7,1.75!"];
  a_hora  [label="horário",                pos="-6.7,1.25!"];
  a_dia   [label="dia da semana",          pos="-6.7,0.75!",  style="rounded,dashed,filled"];
  a_pista [label="tipo de pista",          pos="-6.7,0.25!"];
  a_solo  [label="uso do solo",            pos="-6.7,-0.25!"];
  a_class [label="classificação",          pos="-6.7,-0.75!"];
  a_cond  [label="condição meteorológica", pos="-6.7,-1.25!"];
  a_fase  [label="fase do dia",            pos="-6.7,-1.75!"];
  a_vit   [label="totais de vítimas",      pos="-6.7,-2.25!", style="rounded,dashed,filled"];

  /* ACIDENTE — linha de cima: compostos e multivalorados */
  a_local [label=<<B>local</B>>,           pos="-3.4,2.6!"];
  a_br    [label="BR",                     pos="-5.3,4.0!"];
  a_km    [label="km",                     pos="-4.35,4.0!"];
  a_sent  [label="sentido",                pos="-3.4,4.0!"];
  a_mun   [label="município",              pos="-2.35,4.0!"];
  a_uf    [label="UF",                     pos="-1.45,4.0!"];

  a_coord [label=<<B>coordenadas</B>>,     pos="0.4,2.6!"];
  a_lat   [label="latitude",               pos="-0.3,4.0!"];
  a_lon   [label="longitude",              pos="1.1,4.0!"];

  a_causa [label=<<B>causas</B>>,          pos="3.0,2.6!", peripheries=2];
  a_c_des [label="descrição",              pos="2.4,4.0!"];
  a_c_pri [label="principal?",             pos="3.65,4.0!"];

  a_tipos [label=<<B>tipos</B>>,           pos="5.4,2.6!", peripheries=2];
  a_t_ord [label="ordem",                  pos="4.85,4.0!"];
  a_t_tip [label="tipo",                   pos="5.95,4.0!"];

  a_trac  [label=<<B>traçado da via</B>>,  pos="7.8,2.6!", peripheries=2];

  /* VEÍCULO — coluna da direita */
  v_id    [label=<<U>id_veiculo</U>>,      pos="15.2,0.9!"];
  v_tipo  [label="tipo de veículo",        pos="15.2,0.3!"];
  v_marca [label="marca/modelo",           pos="15.2,-0.3!"];
  v_ano   [label="ano de fabricação",      pos="15.2,-0.9!"];

  /* PESSOA — coluna da direita */
  p_id    [label=<<U>pesid</U>>,           pos="15.2,-4.8!"];
  p_env   [label="tipo de envolvido",      pos="15.2,-5.4!"];
  p_est   [label="estado físico",          pos="15.2,-6.0!"];
  p_idade [label="idade",                  pos="15.2,-6.6!"];
  p_sexo  [label="sexo",                   pos="15.2,-7.2!"];

  /* Unidades da PRF — sigla embaixo de cada uma */
  u_sigla [label=<<U>sigla</U>>,           pos="2.6,-7.9!"];
  d_sigla [label=<<U>sigla</U>>,           pos="-1,-7.9!"];
  s_sigla [label=<<U>sigla</U>>,           pos="-4.9,-7.9!"];

  /* ===================== ENTIDADE — ATRIBUTO ===================== */
  ACIDENTE -- {a_id a_data a_hora a_pista a_solo a_class a_cond a_fase};
  ACIDENTE -- {a_dia a_vit} [style=dashed];
  ACIDENTE -- {a_local a_coord a_causa a_tipos a_trac};
  a_local  -- {a_br a_km a_sent a_mun a_uf};
  a_coord  -- {a_lat a_lon};
  a_causa  -- {a_c_des a_c_pri};
  a_tipos  -- {a_t_ord a_t_tip};
  VEICULO  -- {v_id v_tipo v_marca v_ano};
  PESSOA   -- {p_id p_env p_est p_idade p_sexo};
  UOP -- u_sigla;  DELEG -- d_sigla;  SUPER -- s_sigla;

  /* ===================== RELACIONAMENTOS + CARDINALIDADES ===================== */
  edge [penwidth=1.3];
  ACIDENTE -- r_env_v  [xlabel="1"];
  r_env_v  -- VEICULO  [xlabel="N", color="black:white:black"];
  ACIDENTE -- r_env_p  [xlabel="1", color="black:white:black"];
  r_env_p  -- PESSOA   [xlabel="N", color="black:white:black"];
  VEICULO  -- r_ocupa  [xlabel="0..1"];
  r_ocupa  -- PESSOA   [xlabel="N"];
  ACIDENTE -- r_at_u   [xlabel="N"];
  r_at_u   -- UOP      [xlabel="0..1"];
  ACIDENTE -- r_at_d   [xlabel="N"];
  r_at_d   -- DELEG    [xlabel="0..1"];
  ACIDENTE -- r_at_s   [xlabel="N"];
  r_at_s   -- SUPER    [xlabel="0..1"];
  DELEG    -- r_sub_ud [xlabel="1"];
  r_sub_ud -- UOP      [xlabel="N", color="black:white:black"];
  SUPER    -- r_sub_ds [xlabel="1"];
  r_sub_ds -- DELEG    [xlabel="N", color="black:white:black"];

  /* ===================== NOTAS ===================== */
  nota_arco [shape=plain, fontsize=10, pos="-2.95,-4.95!",
             label=<<I>arco exclusivo: cada acidente é<BR/>atendido por no máximo UMA<BR/>das três unidades (a mais específica)</I>>];

  legenda [shape=plain, fontsize=10, pos="13.6,-9.0!", label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="1" CELLPADDING="3">
      <TR><TD COLSPAN="2"><B>Legenda</B></TD></TR>
      <TR><TD ALIGN="LEFT">retângulo</TD><TD ALIGN="LEFT">entidade</TD></TR>
      <TR><TD ALIGN="LEFT">losango</TD><TD ALIGN="LEFT">relacionamento</TD></TR>
      <TR><TD ALIGN="LEFT">caixa arredondada</TD><TD ALIGN="LEFT">atributo (<U>sublinhado</U>&nbsp;= chave)</TD></TR>
      <TR><TD ALIGN="LEFT">borda dupla</TD><TD ALIGN="LEFT">atributo multivalorado</TD></TR>
      <TR><TD ALIGN="LEFT">borda tracejada</TD><TD ALIGN="LEFT">atributo derivado (calculado)</TD></TR>
      <TR><TD ALIGN="LEFT"><B>negrito</B>&nbsp;+ sub-caixas</TD><TD ALIGN="LEFT">atributo composto</TD></TR>
      <TR><TD ALIGN="LEFT">linha dupla</TD><TD ALIGN="LEFT">participação total</TD></TR>
      <TR><TD ALIGN="LEFT">1 · N · 0..1</TD><TD ALIGN="LEFT">cardinalidade</TD></TR>
    </TABLE>>];
}
