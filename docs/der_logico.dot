digraph DER_logico {
  graph [rankdir=LR, splines=spline, nodesep=0.35, ranksep=1.1, pad=0.4, fontname="DejaVu Sans", fontsize=22, labelloc=t, label=<<B>USUPORT — modelo lógico (3FN)</B><BR/><FONT POINT-SIZE="13">16 tabelas · PK/FK · pé-de-galinha · gerado do INFORMATION_SCHEMA</FONT>>];
  node [shape=plain, fontname="DejaVu Sans", fontsize=11];
  edge [fontname="DejaVu Sans", fontsize=9, color="#52514e", dir=both, penwidth=1.2];
  acidente [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#2a78d6"><TR><TD BGCOLOR="#2a78d6" COLSPAN="3"><FONT COLOR="white"><B>acidente</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_w">PK</TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT" PORT="id_e"><FONT COLOR="#6b6a66">int unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="data_w"></TD><TD ALIGN="LEFT">data</TD><TD ALIGN="LEFT" PORT="data_e"><FONT COLOR="#6b6a66">date</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="horario_w"></TD><TD ALIGN="LEFT">horario</TD><TD ALIGN="LEFT" PORT="horario_e"><FONT COLOR="#6b6a66">time</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="br_w"></TD><TD ALIGN="LEFT">br</TD><TD ALIGN="LEFT" PORT="br_e"><FONT COLOR="#6b6a66">smallint unsigned ?</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="km_w"></TD><TD ALIGN="LEFT">km</TD><TD ALIGN="LEFT" PORT="km_e"><FONT COLOR="#6b6a66">decimal(6,1) ?</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="sentido_w"></TD><TD ALIGN="LEFT">sentido</TD><TD ALIGN="LEFT" PORT="sentido_e"><FONT COLOR="#6b6a66">varchar(13)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="tipo_pista_w"></TD><TD ALIGN="LEFT">tipo_pista</TD><TD ALIGN="LEFT" PORT="tipo_pista_e"><FONT COLOR="#6b6a66">varchar(8)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="uso_solo_w"></TD><TD ALIGN="LEFT">uso_solo</TD><TD ALIGN="LEFT" PORT="uso_solo_e"><FONT COLOR="#6b6a66">varchar(6)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="classificacao_w"></TD><TD ALIGN="LEFT">classificacao</TD><TD ALIGN="LEFT" PORT="classificacao_e"><FONT COLOR="#6b6a66">varchar(20) ?</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="latitude_w"></TD><TD ALIGN="LEFT">latitude</TD><TD ALIGN="LEFT" PORT="latitude_e"><FONT COLOR="#6b6a66">decimal(12,10)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="longitude_w"></TD><TD ALIGN="LEFT">longitude</TD><TD ALIGN="LEFT" PORT="longitude_e"><FONT COLOR="#6b6a66">decimal(13,10)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_cidade_w">FK</TD><TD ALIGN="LEFT">id_cidade</TD><TD ALIGN="LEFT" PORT="id_cidade_e"><FONT COLOR="#6b6a66">smallint unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_condicao_w">FK</TD><TD ALIGN="LEFT">id_condicao</TD><TD ALIGN="LEFT" PORT="id_condicao_e"><FONT COLOR="#6b6a66">tinyint unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_fase_dia_w">FK</TD><TD ALIGN="LEFT">id_fase_dia</TD><TD ALIGN="LEFT" PORT="id_fase_dia_e"><FONT COLOR="#6b6a66">tinyint unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_uop_w">FK</TD><TD ALIGN="LEFT">id_uop</TD><TD ALIGN="LEFT" PORT="id_uop_e"><FONT COLOR="#6b6a66">smallint unsigned ?</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_delegacia_w">FK</TD><TD ALIGN="LEFT">id_delegacia</TD><TD ALIGN="LEFT" PORT="id_delegacia_e"><FONT COLOR="#6b6a66">smallint unsigned ?</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_superintendencia_w">FK</TD><TD ALIGN="LEFT">id_superintendencia</TD><TD ALIGN="LEFT" PORT="id_superintendencia_e"><FONT COLOR="#6b6a66">smallint unsigned ?</FONT></TD></TR></TABLE>>];
  acidente_tipo [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#008300"><TR><TD BGCOLOR="#008300" COLSPAN="3"><FONT COLOR="white"><B>acidente_tipo</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_acidente_w">PK FK</TD><TD ALIGN="LEFT"><B>id_acidente</B></TD><TD ALIGN="LEFT" PORT="id_acidente_e"><FONT COLOR="#6b6a66">int unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ordem_w">PK</TD><TD ALIGN="LEFT"><B>ordem</B></TD><TD ALIGN="LEFT" PORT="ordem_e"><FONT COLOR="#6b6a66">tinyint unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_tipo_w">FK</TD><TD ALIGN="LEFT">id_tipo</TD><TD ALIGN="LEFT" PORT="id_tipo_e"><FONT COLOR="#6b6a66">tinyint unsigned</FONT></TD></TR></TABLE>>];
  acidente_tracado [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#008300"><TR><TD BGCOLOR="#008300" COLSPAN="3"><FONT COLOR="white"><B>acidente_tracado</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_acidente_w">PK FK</TD><TD ALIGN="LEFT"><B>id_acidente</B></TD><TD ALIGN="LEFT" PORT="id_acidente_e"><FONT COLOR="#6b6a66">int unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_tracado_w">PK FK</TD><TD ALIGN="LEFT"><B>id_tracado</B></TD><TD ALIGN="LEFT" PORT="id_tracado_e"><FONT COLOR="#6b6a66">tinyint unsigned</FONT></TD></TR></TABLE>>];
  causa [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#52514e"><TR><TD BGCOLOR="#52514e" COLSPAN="3"><FONT COLOR="white"><B>causa</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_w">PK</TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT" PORT="id_e"><FONT COLOR="#6b6a66">smallint unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="descricao_w"></TD><TD ALIGN="LEFT">descricao</TD><TD ALIGN="LEFT" PORT="descricao_e"><FONT COLOR="#6b6a66">varchar(120)</FONT></TD></TR></TABLE>>];
  causa_acidente [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#008300"><TR><TD BGCOLOR="#008300" COLSPAN="3"><FONT COLOR="white"><B>causa_acidente</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_acidente_w">PK FK</TD><TD ALIGN="LEFT"><B>id_acidente</B></TD><TD ALIGN="LEFT" PORT="id_acidente_e"><FONT COLOR="#6b6a66">int unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_causa_w">PK FK</TD><TD ALIGN="LEFT"><B>id_causa</B></TD><TD ALIGN="LEFT" PORT="id_causa_e"><FONT COLOR="#6b6a66">smallint unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="principal_w"></TD><TD ALIGN="LEFT">principal</TD><TD ALIGN="LEFT" PORT="principal_e"><FONT COLOR="#6b6a66">tinyint(1)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="marcador_principal_w">GER</TD><TD ALIGN="LEFT">marcador_principal</TD><TD ALIGN="LEFT" PORT="marcador_principal_e"><FONT COLOR="#6b6a66">int unsigned ?</FONT></TD></TR></TABLE>>];
  cidade [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#52514e"><TR><TD BGCOLOR="#52514e" COLSPAN="3"><FONT COLOR="white"><B>cidade</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_w">PK</TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT" PORT="id_e"><FONT COLOR="#6b6a66">smallint unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nome_w"></TD><TD ALIGN="LEFT">nome</TD><TD ALIGN="LEFT" PORT="nome_e"><FONT COLOR="#6b6a66">varchar(60)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="uf_w"></TD><TD ALIGN="LEFT">uf</TD><TD ALIGN="LEFT" PORT="uf_e"><FONT COLOR="#6b6a66">char(2)</FONT></TD></TR></TABLE>>];
  condicao_meteorologica [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#52514e"><TR><TD BGCOLOR="#52514e" COLSPAN="3"><FONT COLOR="white"><B>condicao_meteorologica</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_w">PK</TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT" PORT="id_e"><FONT COLOR="#6b6a66">tinyint unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="descricao_w"></TD><TD ALIGN="LEFT">descricao</TD><TD ALIGN="LEFT" PORT="descricao_e"><FONT COLOR="#6b6a66">varchar(30)</FONT></TD></TR></TABLE>>];
  delegacia [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#6250d6"><TR><TD BGCOLOR="#6250d6" COLSPAN="3"><FONT COLOR="white"><B>delegacia</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_w">PK</TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT" PORT="id_e"><FONT COLOR="#6b6a66">smallint unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="sigla_w"></TD><TD ALIGN="LEFT">sigla</TD><TD ALIGN="LEFT" PORT="sigla_e"><FONT COLOR="#6b6a66">varchar(12)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_superintendencia_w">FK</TD><TD ALIGN="LEFT">id_superintendencia</TD><TD ALIGN="LEFT" PORT="id_superintendencia_e"><FONT COLOR="#6b6a66">smallint unsigned</FONT></TD></TR></TABLE>>];
  fase_dia [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#52514e"><TR><TD BGCOLOR="#52514e" COLSPAN="3"><FONT COLOR="white"><B>fase_dia</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_w">PK</TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT" PORT="id_e"><FONT COLOR="#6b6a66">tinyint unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="descricao_w"></TD><TD ALIGN="LEFT">descricao</TD><TD ALIGN="LEFT" PORT="descricao_e"><FONT COLOR="#6b6a66">varchar(20)</FONT></TD></TR></TABLE>>];
  pessoa [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#2a78d6"><TR><TD BGCOLOR="#2a78d6" COLSPAN="3"><FONT COLOR="white"><B>pessoa</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="pesid_w">PK</TD><TD ALIGN="LEFT"><B>pesid</B></TD><TD ALIGN="LEFT" PORT="pesid_e"><FONT COLOR="#6b6a66">int unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_acidente_w">FK</TD><TD ALIGN="LEFT">id_acidente</TD><TD ALIGN="LEFT" PORT="id_acidente_e"><FONT COLOR="#6b6a66">int unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_veiculo_w">FK</TD><TD ALIGN="LEFT">id_veiculo</TD><TD ALIGN="LEFT" PORT="id_veiculo_e"><FONT COLOR="#6b6a66">int unsigned ?</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="tipo_envolvido_w"></TD><TD ALIGN="LEFT">tipo_envolvido</TD><TD ALIGN="LEFT" PORT="tipo_envolvido_e"><FONT COLOR="#6b6a66">varchar(10)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="estado_fisico_w"></TD><TD ALIGN="LEFT">estado_fisico</TD><TD ALIGN="LEFT" PORT="estado_fisico_e"><FONT COLOR="#6b6a66">varchar(15)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="idade_w"></TD><TD ALIGN="LEFT">idade</TD><TD ALIGN="LEFT" PORT="idade_e"><FONT COLOR="#6b6a66">tinyint unsigned ?</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="sexo_w"></TD><TD ALIGN="LEFT">sexo</TD><TD ALIGN="LEFT" PORT="sexo_e"><FONT COLOR="#6b6a66">varchar(13)</FONT></TD></TR></TABLE>>];
  superintendencia [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#6250d6"><TR><TD BGCOLOR="#6250d6" COLSPAN="3"><FONT COLOR="white"><B>superintendencia</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_w">PK</TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT" PORT="id_e"><FONT COLOR="#6b6a66">smallint unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="sigla_w"></TD><TD ALIGN="LEFT">sigla</TD><TD ALIGN="LEFT" PORT="sigla_e"><FONT COLOR="#6b6a66">varchar(10)</FONT></TD></TR></TABLE>>];
  tipo_acidente [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#52514e"><TR><TD BGCOLOR="#52514e" COLSPAN="3"><FONT COLOR="white"><B>tipo_acidente</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_w">PK</TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT" PORT="id_e"><FONT COLOR="#6b6a66">tinyint unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="descricao_w"></TD><TD ALIGN="LEFT">descricao</TD><TD ALIGN="LEFT" PORT="descricao_e"><FONT COLOR="#6b6a66">varchar(50)</FONT></TD></TR></TABLE>>];
  tipo_veiculo [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#52514e"><TR><TD BGCOLOR="#52514e" COLSPAN="3"><FONT COLOR="white"><B>tipo_veiculo</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_w">PK</TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT" PORT="id_e"><FONT COLOR="#6b6a66">tinyint unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="descricao_w"></TD><TD ALIGN="LEFT">descricao</TD><TD ALIGN="LEFT" PORT="descricao_e"><FONT COLOR="#6b6a66">varchar(30)</FONT></TD></TR></TABLE>>];
  tracado [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#52514e"><TR><TD BGCOLOR="#52514e" COLSPAN="3"><FONT COLOR="white"><B>tracado</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_w">PK</TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT" PORT="id_e"><FONT COLOR="#6b6a66">tinyint unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="descricao_w"></TD><TD ALIGN="LEFT">descricao</TD><TD ALIGN="LEFT" PORT="descricao_e"><FONT COLOR="#6b6a66">varchar(30)</FONT></TD></TR></TABLE>>];
  uop [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#6250d6"><TR><TD BGCOLOR="#6250d6" COLSPAN="3"><FONT COLOR="white"><B>uop</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_w">PK</TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT" PORT="id_e"><FONT COLOR="#6b6a66">smallint unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="sigla_w"></TD><TD ALIGN="LEFT">sigla</TD><TD ALIGN="LEFT" PORT="sigla_e"><FONT COLOR="#6b6a66">varchar(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_delegacia_w">FK</TD><TD ALIGN="LEFT">id_delegacia</TD><TD ALIGN="LEFT" PORT="id_delegacia_e"><FONT COLOR="#6b6a66">smallint unsigned</FONT></TD></TR></TABLE>>];
  veiculo [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#2a78d6"><TR><TD BGCOLOR="#2a78d6" COLSPAN="3"><FONT COLOR="white"><B>veiculo</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_w">PK</TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT" PORT="id_e"><FONT COLOR="#6b6a66">int unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_acidente_w">FK</TD><TD ALIGN="LEFT">id_acidente</TD><TD ALIGN="LEFT" PORT="id_acidente_e"><FONT COLOR="#6b6a66">int unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_tipo_veiculo_w">FK</TD><TD ALIGN="LEFT">id_tipo_veiculo</TD><TD ALIGN="LEFT" PORT="id_tipo_veiculo_e"><FONT COLOR="#6b6a66">tinyint unsigned</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="marca_w"></TD><TD ALIGN="LEFT">marca</TD><TD ALIGN="LEFT" PORT="marca_e"><FONT COLOR="#6b6a66">varchar(40) ?</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ano_fabricacao_w"></TD><TD ALIGN="LEFT">ano_fabricacao</TD><TD ALIGN="LEFT" PORT="ano_fabricacao_e"><FONT COLOR="#6b6a66">smallint unsigned ?</FONT></TD></TR></TABLE>>];
  acidente:id_cidade_e:e -> cidade:id_w:w [arrowtail=crowodot, arrowhead=teetee];
  acidente:id_condicao_e:e -> condicao_meteorologica:id_w:w [arrowtail=crowodot, arrowhead=teetee];
  acidente:id_delegacia_e:e -> delegacia:id_w:w [arrowtail=crowodot, arrowhead=teeodot, style=dashed];
  acidente:id_fase_dia_e:e -> fase_dia:id_w:w [arrowtail=crowodot, arrowhead=teetee];
  acidente:id_superintendencia_e:e -> superintendencia:id_w:w [arrowtail=crowodot, arrowhead=teeodot, style=dashed];
  acidente:id_uop_e:e -> uop:id_w:w [arrowtail=crowodot, arrowhead=teeodot, style=dashed];
  acidente_tipo:id_acidente_e:e -> acidente:id_w:w [arrowtail=crowodot, arrowhead=teetee];
  acidente_tipo:id_tipo_e:e -> tipo_acidente:id_w:w [arrowtail=crowodot, arrowhead=teetee];
  acidente_tracado:id_acidente_e:e -> acidente:id_w:w [arrowtail=crowodot, arrowhead=teetee];
  acidente_tracado:id_tracado_e:e -> tracado:id_w:w [arrowtail=crowodot, arrowhead=teetee];
  causa_acidente:id_acidente_e:e -> acidente:id_w:w [arrowtail=crowodot, arrowhead=teetee];
  causa_acidente:id_causa_e:e -> causa:id_w:w [arrowtail=crowodot, arrowhead=teetee];
  delegacia:id_superintendencia_e:e -> superintendencia:id_w:w [arrowtail=crowodot, arrowhead=teetee];
  pessoa:id_acidente_e:e -> acidente:id_w:w [arrowtail=crowodot, arrowhead=teetee];
  pessoa:id_veiculo_e:e -> veiculo:id_w:w [arrowtail=crowodot, arrowhead=teeodot, style=dashed, label="id_veiculo,id_acidente"];
  uop:id_delegacia_e:e -> delegacia:id_w:w [arrowtail=crowodot, arrowhead=teetee];
  veiculo:id_acidente_e:e -> acidente:id_w:w [arrowtail=crowodot, arrowhead=teetee];
  veiculo:id_tipo_veiculo_e:e -> tipo_veiculo:id_w:w [arrowtail=crowodot, arrowhead=teetee];
  legenda [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="2" CELLPADDING="3" COLOR="#8a8984">
      <TR><TD COLSPAN="2"><B>Legenda</B></TD></TR>
      <TR><TD BGCOLOR="#2a78d6"> </TD><TD ALIGN="LEFT">entidades principais</TD></TR>
      <TR><TD BGCOLOR="#008300"> </TD><TD ALIGN="LEFT">associativas (multivalorados N:N)</TD></TR>
      <TR><TD BGCOLOR="#6250d6"> </TD><TD ALIGN="LEFT">hierarquia da PRF</TD></TR>
      <TR><TD BGCOLOR="#52514e"> </TD><TD ALIGN="LEFT">catálogos</TD></TR>
      <TR><TD ALIGN="LEFT">PK / FK / GER</TD><TD ALIGN="LEFT">chave primária / estrangeira / coluna gerada</TD></TR>
      <TR><TD ALIGN="LEFT">tipo ?</TD><TD ALIGN="LEFT">aceita NULL</TD></TR>
      <TR><TD ALIGN="LEFT">linha tracejada</TD><TD ALIGN="LEFT">FK opcional (0..1)</TD></TR>
    </TABLE>>];
}